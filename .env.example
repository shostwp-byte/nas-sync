# ==============================================================================
# CẤU HÌNH HỆ THỐNG NAS-SYNC — UNIVERSAL MULTI-NAS & DOCKER BACKUP PLATFORM
# Repository: https://github.com/shostwp-byte/nas-sync
# ==============================================================================

# URL truy cập công khai qua Reverse Proxy / Nginx / Traefik / Cloudflare Tunnel
APP_URL=https://backup.example.com
APP_HOST_PORT=3080

# Đường dẫn thư mục sao lưu thật trên thiết bị NAS / Máy chủ Linux ánh xạ vào Container:
# - TrueNAS SCALE:        /mnt/tank/vps_backups
# - QNAP QTS / QuTS hero: /share/CACHEDEV1_DATA/VPS_Backups  (hoặc /share/ZFS1_DATA/VPS_Backups)
# - UGREEN / Asustor:     /volume1/VPS_Backups
# - TerraMaster TOS:      /Volume1/VPS_Backups
# - Unraid:               /mnt/cache/vps_backups             (hoặc /mnt/disk1/vps_backups)
# - OpenMediaVault/Linux: /srv/dev-disk-by-uuid-.../vps_backups (hoặc /opt/nas-sync/backups)
NAS_VOL1_PATH=/volume1/VPS_Backups
NAS_VOL2_PATH=/volume2/VPS_Backups

# Tài khoản Admin khởi tạo lần đầu (có thể đổi mật khẩu trực tiếp trên giao diện Web)
# Nếu quên mật khẩu cũ trong CSDL, đặt FORCE_RESET_ADMIN_PASSWORD=true rồi khởi động lại Container để áp dụng mật khẩu dưới đây:
ADMIN_USERNAME=admin
ADMIN_PASSWORD=nas-sync@2026
FORCE_RESET_ADMIN_PASSWORD=false
# Nếu mất thiết bị xác thực 2FA và mã khôi phục, đặt FORCE_RESET_ADMIN_2FA=true rồi khởi động lại Container để gỡ khóa 2FA cho Admin gốc:
FORCE_RESET_ADMIN_2FA=false
# Để trống để NAS-Sync tự sinh khóa ngẫu nhiên (lưu tại DATA_DIR/.jwt_secret & DATA_DIR/.totp_secret). Nếu tự đặt: tối thiểu 32 ký tự, VD: openssl rand -hex 32
JWT_SECRET=
TOTP_ENCRYPTION_KEY=

# Quyền UID/GID chạy tiến trình bên trong Container (mặc định 1000:1000 non-root; điều chỉnh theo UID/GID tài khoản quản lý dữ liệu trên NAS)
PUID=1000
PGID=1000

# Chỉ bật TRUST_PROXY=true khi chạy sau Reverse Proxy tin cậy (Cloudflare Tunnel / Nginx / Traefik / NAS Reverse Proxy)
# VÀ đã khóa tường lửa không cho truy cập trực tiếp từ bên ngoài vào cổng HTTP nội bộ (3080/3000), tránh giả mạo header X-Forwarded-For!
TRUST_PROXY=false

# Hàng đợi Redis (Mặc định kết nối tới container redis nội bộ)
REDIS_URL=redis://redis:6379

# MariaDB Sandbox kiểm tra tính toàn vẹn file SQL sau khi Backup
SANDBOX_DB_HOST=db_sandbox
SANDBOX_DB_PORT=3306
SANDBOX_DB_USER=root
SANDBOX_DB_PASSWORD=sandbox_secret_pass

# Cấu hình Phân vùng lưu trữ bên trong Container (VD: /mnt/vol1 hoặc /mnt/vol1,/mnt/vol2)
STORAGE_VOLUMES=/mnt/vol1
VOLUME_MAX_USAGE_PERCENT=85
VOLUME_MIN_FREE_GB=10

# Cấu hình Nguồn Cập nhật Trực tiếp từ GitHub (1-Click Self-Update đã ký số Ed25519)
GITHUB_REPO_OWNER=shostwp-byte
GITHUB_REPO_NAME=nas-sync
GITHUB_REPO_BRANCH=main
GITHUB_TOKEN=

# Cảnh báo qua Telegram Bot (Có thể cấu hình trực tiếp trên giao diện Web)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Báo cáo & Cảnh báo qua SMTP Email (Có thể cấu hình trên giao diện Web)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
ALERT_EMAIL_TO=

# Khóa Bất biến Snapshot Cấp Hệ điều hành (OS-Level WORM Snapshot — Tùy chọn trên Web UI)
# WORM_PROVIDER hỗ trợ: NONE | TRUENAS_ZFS | NAS_WEBAPI | WEBHOOK
# Mặc định kiểm tra nghiêm ngặt chứng chỉ TLS (WORM_TLS_VERIFY=true). Đặt WORM_TLS_VERIFY=false nếu dùng chứng chỉ tự ký nội bộ LAN.
WORM_PROVIDER=NONE
WORM_API_URL=
WORM_API_KEY=
WORM_USERNAME=
WORM_PASSWORD=
WORM_TARGET_SHARES=VPS_Backups
WORM_WEBHOOK_SECRET=
WORM_TLS_VERIFY=true
