{
  "name": "nas-sync",
  "version": "1.7.0",
  "private": false,
  "license": "MIT",
  "description": "Open-Source Agentless Multi-Panel VPS Backup & Cross-Panel Migration Platform for Multi-NAS & Docker (DirectAdmin, cPanel, Plesk, aaPanel, CyberPanel, HestiaCP, CloudPanel)",
  "homepage": "https://github.com/shostwp-byte/nas-sync",
  "repository": {
    "type": "git",
    "url": "https://github.com/shostwp-byte/nas-sync.git"
  },
  "bugs": {
    "url": "https://github.com/shostwp-byte/nas-sync/issues"
  },
  "keywords": [
    "nas",
    "multi-nas",
    "docker",
    "truenas",
    "qnap",
    "ugreen",
    "unraid",
    "openmediavault",
    "backup",
    "rsync",
    "hardlink",
    "directadmin",
    "cpanel",
    "plesk",
    "aapanel",
    "zfs",
    "btrfs",
    "worm",
    "ransomware-protection"
  ],
  "scripts": {
    "dev": "node --import tsx server.ts",
    "build": "next build",
    "start": "cross-env NODE_ENV=production node --import tsx server.ts",
    "start:prod": "NODE_ENV=production node --import tsx server.ts",
    "lint": "eslint src server.ts scripts tests",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/security-and-engine.test.ts tests/v160-security-audit.test.ts tests/v170-multi-nas.test.ts",
    "pack:release": "node scripts/package-release.mjs",
    "pack:prebuilt": "node scripts/package-prebuilt.mjs"
  },
  "dependencies": {
    "bullmq": "^5.40.0",
    "diff": "^7.0.0",
    "ioredis": "^5.5.0",
    "jose": "^6.0.8",
    "lucide-react": "^0.475.0",
    "mysql2": "^3.12.0",
    "next": "^15.2.4",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/diff": "^7.0.0",
    "@types/node": "^22.13.8",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "^10.14.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.72.1"
  }
}
